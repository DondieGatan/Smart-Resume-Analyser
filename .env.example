# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) — this file is just the template.

# --- Flask ---
# A long random string. If left unset, the app generates and persists one
# locally in .flask_secret_key for convenience during development, but a
# real deployment should always set this explicitly so sessions survive
# restarts/redeploys and multiple app instances share the same key.
SECRET_KEY=

# --- Database (Postgres) ---
# A free Neon (neon.tech) project works well — see README for setup.
# DB_SCHEMA lets one Postgres database host separate schemas per
# environment (e.g. "resume_analyser" in production, "resume_analyser_dev"
# locally) without needing separate free databases.
DATABASE_URL=
DB_SCHEMA=resume_analyser_dev

# --- Email (used for password-reset and email-verification codes) ---
# For Gmail: MAIL_USERNAME is the sending address, and MAIL_PASSWORD is a
# 16-character App Password (myaccount.google.com/apppasswords) — not the
# account's regular login password. Requires 2-Step Verification to be on.
# Without these set, mail.send() fails and the affected route just flashes
# an error asking the user to retry — no code is ever shown on the page.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- SendGrid (HTTP-based transactional email) ---
# Preferred over Resend/SMTP when set — used for password-reset and
# email-verification codes in production, where outbound SMTP is commonly
# blocked. SENDGRID_FROM must exactly match the address verified under
# Settings > Sender Authentication > Single Sender Verification in your
# SendGrid account, or sends will fail.
SENDGRID_API_KEY=
SENDGRID_FROM=

# --- AI Assistant (Resume Builder chat) ---
# Optional. Powers the "AI Assistant" chat panel in the Resume Builder,
# which calls Google's Gemini API — free, no credit card required (get a
# key at aistudio.google.com/apikey). Leave blank to disable the feature —
# the panel will show a "not configured" message instead of erroring.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
